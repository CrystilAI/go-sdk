# Copy to `.env`, fill in what you need, and load it with `set -a; . ./.env; set +a`.
# Integration tests skip unless CRYSTIL_COLLECTOR_URL_BASE is set, and skip each
# provider whose key is unset.

# ─── Crystil ─────────────────────────────────────────────────────────────────
# API key for your Crystil org in the environment the URLs below point at.
CRYSTIL_API_KEY=

# Used when `crystil.New` gets no WithCollectorURL / WithAPIURL option; blank means production.
# Staging: https://staging-collector.crystil.com and https://staging-api.crystil.com.
# Local: http://localhost:8002 (collector) and http://localhost:8000 (backend).
CRYSTIL_COLLECTOR_URL_BASE=
CRYSTIL_API_URL_BASE=

# Set to 1 to also write each integration-test payload to integration/output/,
# with the Crystil API key masked.
CRYSTIL_DUMP_RESPONSES=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Used by: TestOpenAI, TestOpenAIResponses, TestLangChainOpenAI
OPENAI_API_KEY=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Used by: TestAnthropic
ANTHROPIC_API_KEY=

# ─── Google AI Studio (Gemini API) ───────────────────────────────────────────
# Used by: TestGemini, TestLangChainGoogle
GOOGLE_API_KEY=

# ─── Google Vertex AI ────────────────────────────────────────────────────────
# Used by: TestVertex. A service-account JSON file with Vertex AI access; the project
# comes from it unless GOOGLE_CLOUD_PROJECT is set. Location defaults to us-central1.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# ─── Model overrides (optional) ──────────────────────────────────────────────
# Each replaces that provider's default model for the run. Blank uses the default.
OPENAI_MODEL=
ANTHROPIC_MODEL=
GOOGLE_MODEL=
